msgid "MediaTek HNAT"
msgstr "MediaTek HNAT"

#: htdocs/luci-static/resources/view/turboacc.js
msgid "MediaTek HNAT is available and suits MT7988 hardware acceleration."
msgstr "MediaTek HNAT 可用，适用于 MT7988 硬件加速。"

