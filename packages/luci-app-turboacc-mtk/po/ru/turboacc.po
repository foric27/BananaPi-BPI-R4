msgid "TurboACC"
msgstr "Сетевое ускорение"

#: htdocs/luci-static/resources/view/turboacc.js
msgid "TurboACC dashboard"
msgstr "Панель управления TurboACC"

#: htdocs/luci-static/resources/view/turboacc.js
msgid "TurboACC settings"
msgstr "Панель настройки TurboACC"

