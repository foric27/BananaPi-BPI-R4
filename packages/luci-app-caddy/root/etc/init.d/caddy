#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG="$(uci -q get caddy.@caddy[0].bin_dir)"
[ -n "$PROG" ] || PROG="/usr/bin/caddy"
CADDYFILE="/etc/caddy/Caddyfile"

start_service() {
	[ "$(uci -q get caddy.@caddy[0].enabled)" = "1" ] || return 1

	if [ ! -x "$PROG" ]; then
		logger -t caddy "caddy binary not found or not executable: $PROG"
		return 1
	fi

	if [ ! -s "$CADDYFILE" ]; then
		logger -t caddy "$CADDYFILE is missing or empty, not starting"
		return 1
	fi

	procd_open_instance caddy
	procd_set_param command "$PROG" run --config "$CADDYFILE" --adapter caddyfile
	procd_set_param respawn
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance caddy

	echo "$(date +%s)" > /tmp/caddy_time
}

stop_service() {
	rm -f /tmp/caddy_time
	return 0
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "caddy"
}
