#!/bin/sh

# Миграция: убрать устаревшие опции генератора конфига и firewall-автоматику
if uci -q get caddy.@caddy[0] >/dev/null 2>&1; then
	for opt in cmd port webdav webdav_port webdav_pass webdav_username webdav_password webdav_data_dir file_pass file_username file_password filezip webzip cgi api data_dir log allow_wan caddyfile; do
		uci -q delete "caddy.@caddy[0].$opt"
	done
fi

# Дефолты
uci -q get caddy.@caddy[0].bin_dir >/dev/null 2>&1 || uci -q set caddy.@caddy[0].bin_dir='/usr/bin/caddy'
uci -q get caddy.@caddy[0].log_dir >/dev/null 2>&1 || uci -q set caddy.@caddy[0].log_dir='/tmp/caddy/requests.log'
uci -q commit caddy

# Удалить firewall-правило от старой firewall-автоматики
if uci -q get firewall.caddy >/dev/null 2>&1; then
	uci -q delete firewall.caddy
	uci -q commit firewall
fi

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@caddy[-1]
	add ucitrack caddy
	set ucitrack.@caddy[-1].init=caddy
	commit ucitrack
EOF

rm -rf /tmp/luci-*
chmod 755 /etc/init.d/caddy
exit 0
