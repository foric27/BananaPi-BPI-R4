# /etc/caddy/Caddyfile — reverse proxy
# Редактируйте через LuCI (NAS → Caddy) или напрямую в этом файле.
# Проверка конфигурации: caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
# Применение изменений: LuCI → NAS → Caddy → «Перезапустить» (или /etc/init.d/caddy restart)

{
	admin off
	# Отключение HTTP/3 (QUIC): заметно снижает нагрузку CPU при
	# TLS-проксировании. Скорость по HTTP/1.1 и HTTP/2 не меняется.
	# Если HTTP/3 нужен — удалите блок servers ниже.
	servers {
		protocols h1 h2
	}
	# E-mail для уведомлений Let's Encrypt (проблемы продления и т.п.):
	# email you@example.com
}

# ============================================================
# СЕРТИФИКАТЫ LET'S ENCRYPT (автоматические, бесплатно)
# ============================================================
# Caddy САМ получает и продлевает сертификаты — достаточно
# указать домен в адресе сайта вместо ":порт".
#
# Требования:
#  1. Домен указывает A/AAAA-записью на этот роутер.
#  2. Порты 80 и 443 открыты в firewall (WAN) и не заняты:
#     по умолчанию LuCI (uhttpd) слушает :80 — перенесите LuCI
#     на другой порт (Система → Администрирование → HTTP-порт),
#     иначе Caddy не сможет пройти проверку HTTP-01.
#  3. Первый выпуск сертификата требует доступности роутера
#     из интернета; продление — автоматически за 30 дней
#     до истечения срока.
#
# Внимание: wildcard *.example.com через DNS-challenge НЕ
# поддержан в стандартной сборке Caddy (нужен модуль
# DNS-провайдера, например cloudflare).
#
# Пример 1: домен → reverse proxy. HTTPS включается автоматически,
#           HTTP-трафик на :80 редиректится на HTTPS.
# example.com {
# 	reverse_proxy 127.0.0.1:80
# }
#
# Пример 2: несколько поддоменов на разные сервисы локальной сети.
# ha.example.com {
# 	reverse_proxy 192.168.1.50:8123   # Home Assistant (WebSocket работает из коробки)
# }
# nas.example.com {
# 	reverse_proxy 192.168.1.60:5000
# }
# cam.example.com {
# 	reverse_proxy 192.168.1.70:554
# }

# ============================================================
# ЛОКАЛЬНЫЙ HTTPS БЕЗ LET'S ENCRYPT (самоподписанный)
# ============================================================
# Внутренние имена без домена: браузер покажет предупреждение —
# примите его или добавьте корневой сертификат Caddy в доверенные.
# https://router.local {
# 	tls internal
# 	reverse_proxy 127.0.0.1:80
# }

# ============================================================
# СВОИ ФАЙЛЫ СЕРТИФИКАТОВ (выпущенные вручную)
# ============================================================
# my.example.com {
# 	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
# 	reverse_proxy 127.0.0.1:8080
# }

# ============================================================
# ПРОСТОЙ HTTP (без TLS, только из локальной сети)
# ============================================================
# Access-log пишется в /tmp/caddy/requests.log — путь должен
# совпадать с UCI-опцией log_dir (LuCI → Caddy → «Путь к логам»),
# иначе вкладка «Логи» будет пустой.
# :8080 {
# 	log {
# 		output file /tmp/caddy/requests.log {
# 			roll_size     1MiB
# 			roll_keep     5
# 			roll_keep_for 120h
# 		}
# 	}
# 	reverse_proxy 127.0.0.1:80
# }

# ============================================================
# ПРОИЗВОДИТЕЛЬНОСТЬ
# ============================================================
# 1. Не включайте encode (gzip/zstd) для проксирования в LAN —
#    сжатие выполняется на CPU роутера. Для WAN-клиентов на
#    медленных каналах сжатие может быть оправдано:
# 	encode gzip
#
# 2. Локальные апстримы указывайте по IP и по plain HTTP —
#    убирает DNS-запросы и TLS к бэкенду:
# 	reverse_proxy http://192.168.1.50:8123
#
# 3. Для стриминга (Home Assistant, SSE) отключите буферизацию:
# 	flush_interval -1
#
# 4. TLS-проксирование выполняется в userspace и аппаратным
#    ускорением (HNAT) не ускоряется: сотни Мбит/с через
#    Caddy+TLS — норма для MT7988.

# ============================================================
# ПОЛЕЗНЫЕ ДИРЕКТИВЫ (вставлять внутрь блока сайта)
# ============================================================
# Увеличить лимит тела запроса для загрузок через прокси:
# 	request_body {
# 		max_size 512MB
# 	}
#
# Базовая аутентификация перед проксированием (хеш получить так:
# caddy hash-password --plaintext ваш_пароль):
# 	basic_auth {
# 		admin <вставьте сюда сгенерированный хеш>
# 	}
