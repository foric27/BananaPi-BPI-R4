# Caddyfile: /etc/caddy/Caddyfile
  
{ # Глобальная конфигурация
# Модуль CGI
order cgi before respond
# Модуль WebDAV
order webdav before file_server
# Отключить API-порт 
admin off 
} 

:12311 {
# Включить сжатие
encode gzip
# Аутентификация, логин: admin пароль: 123456
basicauth {
admin $2a$14$RdbOHzJhf5BaapSdlYTCbe.yWY9cEZjyDpfgwStY28K/qsM1tX8tu
}
# Корневая директория /mnt
 root * /mnt
# Файловый сервер, порт 12311
 file_server browse
        
 log {
# Лог: /tmp/caddy/requests.log
  output file /tmp/caddy/requests.log {
   roll_size     1MiB
   roll_local_time
   roll_keep     5
   roll_keep_for 120h
  }
 }
 
}

