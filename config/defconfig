# --- Фиксация символов ядра (объявлены в config/Config-kernel.in патчем 1030) ---
# Без NF_CONNTRACK/NF_FLOW_TABLE встроенными vmlinux не линкуется:
# mtk_ppe* (built-in) вызывает nf_*. Символы MTK-патчей пиним, чтобы
# syncconfig не задавал интерактивные запросы (NEW).
CONFIG_KERNEL_NF_CONNTRACK=y
CONFIG_KERNEL_NF_FLOW_TABLE=y
CONFIG_KERNEL_PTP_1588_CLOCK=y
CONFIG_KERNEL_NET_MEDIATEK_HNAT=m
CONFIG_KERNEL_MEDIATEK_NETSYS_V3=y
